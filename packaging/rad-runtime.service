[Unit]
Description=RAD local action deck authority
After=graphical-session.target
PartOf=graphical-session.target
Wants=rad-tray.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/rad-runtime
KillMode=mixed
KillSignal=SIGTERM
Restart=on-failure
RestartPreventExitStatus=75
RestartSec=1
RestartSteps=4
RestartMaxDelaySec=30
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
