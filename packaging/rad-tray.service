# Optional desktop companion, installed by the editor beside rad-runtime.service.
# No separate enable/autostart: the authority starts and stops its tray (ADR 0016).
[Unit]
Description=RAD session tray
BindsTo=rad-runtime.service
PartOf=rad-runtime.service
After=rad-runtime.service

[Service]
Type=simple
ExecStart=/usr/local/bin/rad-tray
Restart=no
TimeoutStopSec=5
